{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/power-bi-semantic-modeling-antipatterns/antipattern-schema.json",
  "title": "Power BI semantic modeling anti-pattern rule",
  "type": "object",
  "required": ["id", "family", "name", "severity", "inject", "detect", "remediate"],
  "properties": {
    "id": {"type": "string", "pattern": "^AP-[A-Z]+-[0-9]{3}$"},
    "family": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "severity": {"enum": ["Info", "Warning", "Error"]},
    "inject": {"type": "string", "minLength": 1},
    "detect": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "remediate": {"type": "string", "minLength": 1},
    "implementation": {
      "type": "object",
      "required": ["target_type", "preconditions", "baseline", "mutation"],
      "properties": {
        "target_type": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "baseline": {"type": "object", "minProperties": 1},
        "mutation": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "expected_detection": {
      "type": "object",
      "required": ["object_type", "evidence"],
      "properties": {
        "object_type": {"type": "string", "minLength": 1},
        "evidence": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["method", "deterministic"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "deterministic": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "implementation": ["expected_detection", "verification"],
    "expected_detection": ["implementation", "verification"],
    "verification": ["implementation", "expected_detection"]
  },
  "additionalProperties": false
}
